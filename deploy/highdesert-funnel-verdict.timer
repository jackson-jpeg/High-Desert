[Unit]
Description=High Desert — daily funnel verdict check

[Timer]
# 17:40 UTC: the Mac's best-reachable hour (the tunnel is up 85% of the
# 17:00 hour), after the 17:15 repo-bundle and the 17:30 backup.
OnCalendar=*-*-* 17:40:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
