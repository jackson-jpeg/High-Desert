[Unit]
Description=High Desert, the nightly mutation run (20:30 UTC)

[Timer]
# Nightly, after peak hours (heavy holds every job 13:00 to 19:00 UTC on
# weekdays). Incremental most nights; the script itself decides when the
# monthly full run is due. Persistent: a night the box missed runs when it is
# back.
OnCalendar=*-*-* 20:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
