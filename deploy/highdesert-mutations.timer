[Unit]
Description=High Desert, the weekly full mutation run (Mondays 14:00 UTC)

[Timer]
# 14:00 UTC, the quietest listening hour in the play data (7 AM Pacific). About
# three hours, so the 17:40 digest reads the finished run; a run still going
# then is reported as running. Persistent: a Monday the box missed runs when it
# is back.
OnCalendar=Mon *-*-* 14:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
