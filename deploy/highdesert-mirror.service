[Unit]
Description=High Desert — archive.org outage mirror (range gateway, 127.0.0.1:3004)
Documentation=file:///opt/highdesert-mirror/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user, unlike highdesert.service: the gateway lives in /opt, not
# /root, so nothing stops it running unprivileged (scripts/deploy-mirror.sh
# creates the user and hands it the two directories below).
User=hdmirror
Group=hdmirror
WorkingDirectory=/opt/highdesert-mirror
ExecStart=/usr/bin/node /opt/highdesert-mirror/server.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=MIRROR_PORT=3004
Environment=MIRROR_CACHE_DIR=/var/cache/highdesert-mirror
Environment=MIRROR_TORRENT_DIR=/var/lib/highdesert-mirror/torrents
Environment=MIRROR_INDEX=/opt/highdesert-mirror/episodes.json
# 20 GB of unpinned cache, never below 10 GB free (the disk had 35 GB free
# when this was written, so the floor is what binds). Pins: warm unit.
Environment=MIRROR_CACHE_MAX_GB=20
Environment=MIRROR_DISK_FLOOR_GB=10
# Seeding cap. The plan (KVM 2) allows 8 TB/month; 2 MB/s flat out is 5.2 TB,
# and nothing else here comes close to the rest.
Environment=MIRROR_UPLOAD_KBPS=2048
Environment=MIRROR_FIRST_BYTE_MS=15000
Environment=MIRROR_TORRENT_PORT=6881
Environment=MIRROR_DHT_PORT=6882
Environment=MIRROR_PUBLIC_PEER=187.77.218.14:6881
# Fetch-only: no seeding, no DHT, no trackers (2026-09-25; CPU).
Environment=MIRROR_SEED=0

# A background service on a two-vCPU box that also serves five live sites:
# it may never take a whole core, and it yields disk to everything else.
CPUQuota=50%
IOWeight=20
MemoryMax=700M
MemoryHigh=600M
Nice=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/cache/highdesert-mirror /var/lib/highdesert-mirror

StandardOutput=journal
StandardError=journal
SyslogIdentifier=highdesert-mirror

[Install]
WantedBy=multi-user.target
