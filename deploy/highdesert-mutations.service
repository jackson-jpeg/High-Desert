[Unit]
Description=High Desert, the weekly full mutation run (scripts/weekly-mutations.sh)
Documentation=file:///root/High-Desert/CLAUDE.md
After=network-online.target postgresql.service

[Service]
Type=oneshot
# Runs the script from the production tree, but every mutation happens in its
# own clone under /var/lib/highdesert-mutations/checkout, never in
# /root/High-Desert. root, for the heavy slot (/run/heavy) and the test
# database's env file.
WorkingDirectory=/root/High-Desert
EnvironmentFile=/root/.high-desert-test.env
ExecStart=/usr/bin/bash /root/High-Desert/scripts/weekly-mutations.sh
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HD_MUTATIONS_STATE=/var/lib/highdesert-mutations
# The normal lane (Jackson, Inbox f27603c8, 2026-11-27). heavy puts a label
# matching HEAVY_LOW_RE in its low lane (one slot at most, only while no normal
# job waits); mutate-check labels every vitest "high-desert mutation", so the
# run checked 35 of 1,337 in 5.5 hours. This is heavy's own default list
# without "mutation", for this unit's calls only: they take turns like any
# session's tests. Every other caller, and heavy.conf, is unchanged.
Environment="HEAVY_LOW_RE=^portfolio|audit|render|envelope"
StateDirectory=highdesert-mutations
# The one High Desert job exempt from the 10% rule (Jackson, 2026-10-15): about
# About 1.3 CPU-hours once a week (1h17m measured 2026-10-15). Every mutation's vitest takes the heavy slot, which
# runs it under nice 15 and waits while the 6-hour CPU mean is over 40%, so it
# never runs beside a build and the live sites come first. No CPUQuota.
Nice=19
IOSchedulingClass=idle
# 20h (the lead, 2026-11-26): 14h ran out on 2026-11-23 with the run waiting
# on the heavy gate; 20h from Mon 19:00 ends Tue 15:00.
TimeoutStartSec=20h
SyslogIdentifier=highdesert-mutations
