[Unit]
Description=High Desert, the nightly mutation run (scripts/weekly-mutations.sh: incremental, full once a month)
Documentation=file:///root/High-Desert/CLAUDE.md
After=network-online.target postgresql.service

[Service]
Type=oneshot
# Runs the script from the production tree, but every mutation happens in its
# own clone under /var/lib/highdesert-mutations/checkout, never in
# /root/High-Desert. root, for the heavy slot (/run/heavy) and the test
# database's env file.
WorkingDirectory=/root/High-Desert
EnvironmentFile=/root/.high-desert-test.env
ExecStart=/usr/bin/bash /root/High-Desert/scripts/weekly-mutations.sh
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HD_MUTATIONS_STATE=/var/lib/highdesert-mutations
StateDirectory=highdesert-mutations
# The hard cap (the lead for Jackson, 2026-11-27: the weekly full run held the
# box near the host's CPU limit for 6+ hours and kept Sanger's tests and
# typecheck re-checks from a heavy slot for days). At most 1.5 cores, the
# lowest CPU and IO priority. No HEAVY_LOW_RE here: heavy's default puts the
# "high-desert mutation" label in its low lane, so each mutation waits while
# any other job waits, and heavy holds it through peak hours. Still named in
# highdesert-status's cpu line as the one exemption from the 10% rule
# (Jackson, 2026-10-15), now with this ceiling.
CPUQuota=150%
Nice=19
IOSchedulingClass=idle
# 16h from 20:30 UTC ends at 12:30, before the next weekday's peak (13:00).
TimeoutStartSec=16h
SyslogIdentifier=highdesert-mutations
