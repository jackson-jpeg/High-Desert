{
  "name": "high-desert",
  "version": "0.5.0",
  "description": "A desktop-grade web player for the Art Bell radio archive",
  "author": "Jackson Goode",
  "license": "MIT",
  "homepage": "https://highdesert.space",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacksongoode/High-Desert"
  },
  "keywords": [
    "art-bell",
    "radio",
    "archive",
    "audio-player",
    "windows-98",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "bash scripts/heavy.sh next build",
    "start": "next start",
    "lint": "bash scripts/heavy.sh eslint",
    "typecheck": "bash scripts/heavy.sh tsc --noEmit",
    "test": "bash scripts/heavy.sh vitest run",
    "test:watch": "vitest",
    "test:mutations": "bash scripts/heavy.sh node scripts/mutate-check.mjs",
    "check:csp": "node scripts/csp-check.mjs",
    "check:seo": "node --no-warnings scripts/seo-check.mjs",
    "test:e2e": "bash scripts/heavy.sh playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "mmdb-lib": "3.0.3",
    "music-metadata": "^11.16.1",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/spark-md5": "^3.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
