# High Desert runs with no third-party services.
#
# Community stats (play counts, ratings, leaderboard, active listeners) are stored
# in Postgres on the same host. Leave DATABASE_URL unset for local development —
# the /api/stats/* routes degrade gracefully and the UI simply shows empty stats.
DATABASE_URL=

# AI categorization is NOT a runtime feature. It runs offline via
# scripts/categorize-library.py and its output ships in public/seed/library.json.
# No API key is ever needed by the app, and none is ever sent to the browser.
